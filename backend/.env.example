# 智研 SaaS 版 — 環境設定
# 複製此檔為 .env 並填入你的 API 金鑰
#
# ⚠️  APP_SECRET_KEY 必須在正式部署前替換為隨機強金鑰
# 產生方式（擇一）：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   openssl rand -base64 48

# LLM API 設定 (支援 OpenAI 相容 API)
ZHIYAN_API_KEY=sk-your-api-key-here
ZHIYAN_API_BASE_URL=https://api.openai.com/v1
ZHIYAN_MODEL=gpt-4o

# 應用設定
APP_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_HERE
APP_PORT=8000
APP_HOST=0.0.0.0

# 若使用 DeepSeek（預設）
# ZHIYAN_API_BASE_URL=https://api.deepseek.com/v1
# ZHIYAN_MODEL=deepseek-chat

# 若使用 OpenRouter
# ZHIYAN_API_BASE_URL=https://openrouter.ai/api/v1
# ZHIYAN_MODEL=anthropic/claude-3.5-sonnet

# 司法院官方裁判書 API（不要提交真實帳密）
# 官方 API：Auth → JList（近期異動）→ JDoc（依 JID 取得全文）
JUDICIAL_API_USER=
JUDICIAL_API_PASSWORD=
JUDICIAL_API_BASE_URL=https://data.judicial.gov.tw/jdg/api
JUDICIAL_API_TIMEOUT=60

# 自有判決向量庫：預設使用本地 Qdrant embedded mode
JUDGMENT_MANIFEST_PATH=data/judgments/manifest.sqlite3
JUDGMENT_QDRANT_PATH=data/qdrant
# 若改用 Qdrant server，將 JUDGMENT_QDRANT_PATH 留空並設定下列兩項
# JUDGMENT_QDRANT_HOST=localhost
# JUDGMENT_QDRANT_PORT=6333
JUDGMENT_QDRANT_COLLECTION=zhiyan_legal_judgments
JUDGMENT_EMBED_MODEL=paraphrase-multilingual-MiniLM-L12-v2
JUDGMENT_EMBED_MODEL_REVISION=
JUDGMENT_CHUNK_MAX_CHARS=800
JUDGMENT_CHUNK_OVERLAP=80
JUDGMENT_EMBED_BATCH_SIZE=32
